# Configure the AWS Provider
terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}
provider "aws" {
  region = "us-east-1"
}


# resources
resource "aws_vpc" "main" {
  cidr_block = "10.0.0.0/16"

  tags = {
    Name = "main_vpc"
  }
}

# ----------- route tables
resource "aws_route_table" "public" {
  vpc_id = aws_vpc.main.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.igw.id
  }
}
resource "aws_route_table" "private" {
  vpc_id = aws_vpc.main.id
  route {
    cidr_block     = "0.0.0.0/0"
    nat_gateway_id = aws_nat_gateway.nat_eip.id
  }
}
# resource "aws_route_table" "private" {
#     vpc_id = aws_vpc.main.id
#     route {
#         cidr_block = "0.0.0.0/0"
#         nat_gateway_id = aws_nat_gateway.nat_eip.id
#     }
# }

resource "aws_route_table_association" "public_web_A" {
  subnet_id      = aws_subnet.public_web_subnetA.id
  route_table_id = aws_route_table.public.id
}
resource "aws_route_table_association" "public_web_B" {
  subnet_id      = aws_subnet.public_web_subnetB.id
  route_table_id = aws_route_table.public.id
}
resource "aws_route_table_association" "private_app_A" {
  subnet_id      = aws_subnet.private_app_subnetA.id
  route_table_id = aws_route_table.private.id
}
resource "aws_route_table_association" "private_app_B" {
  subnet_id      = aws_subnet.private_app_subnetB.id
  route_table_id = aws_route_table.private.id
}
resource "aws_route_table_association" "private_db_A" {
  subnet_id      = aws_subnet.private_db_subnetA.id
  route_table_id = aws_route_table.private.id
}
resource "aws_route_table_association" "private_db_B" {
  subnet_id      = aws_subnet.private_db_subnetB.id
  route_table_id = aws_route_table.private.id
}


# -------- us-east-1a
resource "aws_subnet" "public_web_subnetA" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = "10.0.0.0/20"
  availability_zone       = "us-east-1a"
  map_public_ip_on_launch = true

  tags = {
    Name = "public-web-1a"
  }
}
resource "aws_subnet" "private_app_subnetA" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = "10.0.128.0/20"
  availability_zone       = "us-east-1a"
  map_public_ip_on_launch = false

  tags = {
    Name = "private-app-1a"
  }
}
resource "aws_subnet" "private_db_subnetA" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = "10.0.160.0/20"
  availability_zone       = "us-east-1a"
  map_public_ip_on_launch = false
  tags = {
    Name = "private-db-1a"
  }
}

# -------- us-east-1b
resource "aws_subnet" "public_web_subnetB" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = "10.0.16.0/20"
  availability_zone       = "us-east-1b"
  map_public_ip_on_launch = true

  tags = {
    Name = "public-web-1b"
  }
}
resource "aws_subnet" "private_app_subnetB" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = "10.0.144.0/20"
  availability_zone       = "us-east-1b"
  map_public_ip_on_launch = false

  tags = {
    Name = "private-app-1b"
  }
}
resource "aws_subnet" "private_db_subnetB" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = "10.0.176.0/20"
  availability_zone       = "us-east-1b"
  map_public_ip_on_launch = false
  tags = {
    Name = "private-db-1b"
  }
}

# --------
resource "aws_internet_gateway" "igw" {
  vpc_id = aws_vpc.main.id
}
resource "aws_eip" "nat_eip" {
  domain     = "vpc"
  depends_on = [aws_internet_gateway.igw]
  tags = {
    Name = "nat-gateway-eip"
  }
}
resource "aws_nat_gateway" "nat_eip" {
  allocation_id = aws_eip.nat_eip.id
  subnet_id     = aws_subnet.public_web_subnetA.id

  tags = {
    Name = "main-nat-gateway"
  }

  depends_on = [aws_internet_gateway.igw]
}
resource "aws_iam_role" "ssm_role" {
  name = "ec2-ssm-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Action = "sts:AssumeRole"
      Effect = "Allow"
      Principal = {
        Service = "ec2.amazonaws.com"
      }
    }]
  })
}
resource "aws_iam_role_policy_attachment" "ssm_policy" {
  role       = aws_iam_role.ssm_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
}
resource "aws_iam_instance_profile" "ssm_profile" {
  name = "ec2-ssm-profile"
  role = aws_iam_role.ssm_role.name
}

# -------- EC2 AMI
data "aws_ssm_parameter" "al2023" {
  name = "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
}
# -------- EC2 instance
/*
resource "aws_instance" "web_ec2_A" {
  ami          = data.aws_ssm_parameter.al2023.value
  instance_type = "t3.micro"
  subnet_id = aws_subnet.private_app_subnetA.id
  iam_instance_profile = aws_iam_instance_profile.ssm_profile.name
  vpc_security_group_ids = [aws_security_group.web_ec2_sg.id]

  tags = {
    Name = "web-ec2-A"
  }
}
resource "aws_instance" "web_ec2_B" {
  ami          = data.aws_ssm_parameter.al2023.value
  instance_type = "t3.micro"
  subnet_id = aws_subnet.private_app_subnetA.id
  iam_instance_profile = aws_iam_instance_profile.ssm_profile.name
  vpc_security_group_ids = [aws_security_group.web_ec2_sg.id]

  tags = {
    Name = "web-ec2-B"
  }
}
*/

resource "aws_security_group" "web_ec2_sg" {
  name_prefix = "web-ec2-sg-"
  vpc_id      = aws_vpc.main.id

  ingress {
    from_port       = 80
    to_port         = 80
    protocol        = "tcp"
    security_groups = [aws_security_group.web_alb_sg.id]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_security_group" "web_alb_sg" {
  name_prefix = "web-alb-sg-"
  vpc_id      = aws_vpc.main.id

  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}
resource "aws_lb" "web_alb" {
  name               = "web-alb"
  internal           = false
  load_balancer_type = "application"
  security_groups    = [aws_security_group.web_alb_sg.id]
  subnets            = [aws_subnet.public_web_subnetA.id, aws_subnet.public_web_subnetB.id]
}

resource "aws_lb_target_group" "web_lb_tg" {
  name     = "web-tg"
  port     = 80
  protocol = "HTTP"
  vpc_id   = aws_vpc.main.id

  health_check {
    path    = "/"
    matcher = "200"
  }
}

resource "aws_lb_listener" "web_listener" {
  load_balancer_arn = aws_lb.web_alb.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.web_lb_tg.arn
  }
}

resource "aws_launch_template" "web_lt" {
  name_prefix            = "web-"
  image_id               = data.aws_ssm_parameter.al2023.value
  instance_type          = "t3.micro"
  vpc_security_group_ids = [aws_security_group.web_ec2_sg.id]

  iam_instance_profile {
    name = aws_iam_instance_profile.ssm_profile.name
  }

  metadata_options {
    http_tokens = "required"
  }
  user_data = base64encode(<<-EOF
        #!/bin/bash
        dnf install -y nginx
        echo "Hello from $(hostname -f)" > /usr/share/nginx/html/index.html
        systemctl enable --now nginx
        EOF
  )
  tag_specifications {
    resource_type = "instance"
    tags = {
      Name = "web-asg-instance"
    }
  }
}

resource "aws_autoscaling_group" "web_asg" {
  name                      = "web-asg"
  min_size                  = 2
  max_size                  = 4
  desired_capacity          = 2
  vpc_zone_identifier       = [aws_subnet.public_web_subnetA.id, aws_subnet.public_web_subnetB.id]
  target_group_arns         = [aws_lb_target_group.web_lb_tg.arn]
  health_check_type         = "ELB"
  health_check_grace_period = 120

  launch_template {
    id      = aws_launch_template.web_lt.id
    version = "$Latest"
  }

  depends_on = [
    aws_route_table_association.public_web_A,
    aws_route_table_association.public_web_B
  ]
}

output "web_alb_dns" {
  value = aws_lb.web_alb.dns_name
}

